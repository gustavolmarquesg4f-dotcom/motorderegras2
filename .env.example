# Groq: a mesma plataforma do EnglishOS, mas o segredo é configurado separadamente
# no projeto motorderegras2 da Vercel, nunca no repositório ou na interface.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=true
GROQ_REASONING_EFFORT=high
# AI_PROVIDER=groq restringe o envio de dados à Groq. `auto` seleciona primeiro Groq.
AI_PROVIDER=groq
AI_ALLOW_FALLBACK=false

# Supabase URL and publishable key have safe source-code defaults.
# Override if migrating to another Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# AI on Vercel uses automatic OIDC. Optional alternative: configure this only server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4

# Primeiro provedor: Ollama remoto (requer VM realmente provisionada).
# Use proxy HTTPS com autenticação; NÃO publique 11434 diretamente.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_REASONING=high
# Ordem: Ollama -> OpenAI API (plano cobrado separadamente) -> AI Gateway Vercel.
# A assinatura ChatGPT não disponibiliza uma chave de API nem uma VM Ollama.

# Se definido, seleciona exclusivamente: ollama, openai, gateway ou auto.

# Por padrão, não envia dados a outro provedor quando o escolhido falha.
AI_ALLOW_FALLBACK=false