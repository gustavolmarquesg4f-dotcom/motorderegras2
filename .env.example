# Supabase URL and publishable key have safe source-code defaults.
# Override if migrating to another Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# AI on Vercel uses automatic OIDC. Optional alternative: configure this only server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4